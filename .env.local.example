# Live relay (set this up first, it's what makes phone <-> PC work)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: default TTL for a live item before it quietly expires.
# Can be overridden per item from the UI (1h / 24h / 7d).
DOCK_TTL_SECONDS=86400

# Optional: lock the site behind a single shared password. Leave both
# unset to run with no gate at all.
SITE_PASSWORD=
SITE_PASSWORD_SECRET=

# Permanent storage (optional, only needed for the Save button and Trash).
# SUPABASE_SERVICE_ROLE_KEY is a server-only secret — never prefix it
# with NEXT_PUBLIC_, and never let it reach the browser. Find both
# values under Project Settings > API in your Supabase project
# (the service_role key, not the anon/public key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
