# Live relay (set this up first, it's what makes phone <-> PC work)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: how long an unsaved item stays live before it quietly expires
DOCK_TTL_SECONDS=86400

# Permanent storage (optional, only needed for the Save button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
