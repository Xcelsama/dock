# Live relay (set this up first, it's what makes phone <-> PC work)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: default TTL for a live item before it quietly expires.
# Can be overridden per item from the UI (1h / 24h / 7d).
DOCK_TTL_SECONDS=86400

# Optional: lock the site behind a single shared password. Leave both
# unset to run with no gate at all.
SITE_PASSWORD=
SITE_PASSWORD_SECRET=

# Permanent storage (needed for Save, Pin and Trash).
# Saved item details live in the same Upstash Redis as above; files live in
# Cloudflare R2. Create an R2 bucket, then an API token with Object Read & Write
# for that bucket (R2 > Manage API tokens). Server-only secrets: never prefix
# these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=dock-files

# LEGACY (optional): the old Supabase project. Kept read-only so files saved
# there before the move to R2 can still be opened from the Old files tab
# (/legacy). If Supabase is restricted or removed, only that tab is affected.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: TURN relay for device-to-device transfers. Direct (QR) transfers
# work between most networks using free public STUN alone, but some mobile
# carriers and office networks block direct connections. A TURN server relays
# the (encrypted) traffic for those. Get these from any TURN provider; leave
# blank to run without one. Comma-separate multiple URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
